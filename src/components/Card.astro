---
import { Image } from 'astro:assets';
import type { Project } from '@/data/projects';
import Badge from './Badge.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const {
  title,
  img,
  video,
  href,
  badge,
  post,
  imgBgColor,
  imgContain,
  imgPosition,
  description,
} = project;
---

<div class="flex h-full flex-col overflow-hidden rounded-md border-2 border-gray-200/60 dark:border-gray-700">
  {img && (
    <div
      class="aspect-video overflow-hidden"
      style={imgBgColor ? `background-color: ${imgBgColor}` : undefined}
    >
      <a href={href} aria-label={`Link to ${title}`}>
        <Image
          alt={title}
          src={img}
          widths={[544, 1088]}
          sizes="(min-width: 768px) 544px, 100vw"
          class:list={['h-full w-full', imgContain ? 'object-contain' : 'object-cover']}
          style={imgPosition ? `object-position: ${imgPosition}` : undefined}
          loading="lazy"
        />
      </a>
    </div>
  )}
  {video && (
    <div class="overflow-hidden">
      <a href={href} aria-label={`Link to ${title}`}>
        <video autoplay loop muted playsinline class="hidden h-full w-full object-cover dark:block">
          <source src={video.dark} type="video/mp4" />
        </video>
        <video autoplay loop muted playsinline class="block h-full w-full object-cover dark:hidden">
          <source src={video.light} type="video/mp4" />
        </video>
      </a>
    </div>
  )}
  <div class="flex flex-1 flex-col p-6">
    <div class="mb-3 flex items-center justify-between gap-2">
      <h3 class="text-2xl font-bold leading-8 tracking-tight">
        <a href={href} aria-label={`Link to ${title}`} class="hover:text-primary-500 dark:hover:text-primary-400">
          {title}
        </a>
      </h3>
      {(badge || post) && (
        <div class="flex shrink-0 flex-wrap justify-end gap-1.5">
          {badge && <Badge badge={badge} title={title} />}
          {post && <Badge badge={{ blog: post }} title={title} />}
        </div>
      )}
    </div>
    <p class="prose max-w-none text-gray-500 dark:text-gray-400" set:html={description} />
  </div>
</div>
