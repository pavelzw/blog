---
import Card from '@/components/Card.astro';
import CompactCard from '@/components/CompactCard.astro';
import { projectGroups, projects } from '@/data/projects';
import BaseLayout from '@/layouts/BaseLayout.astro';

const featured = projects.filter((p) => p.featured);

const sections = projectGroups
  .map((group) => {
    const members = projects.filter((p) => p.group === group.id && !p.featured);
    return {
      ...group,
      large: members.filter((p) => !p.compact),
      compact: members.filter((p) => p.compact),
    };
  })
  .filter((section) => section.large.length + section.compact.length > 0);

const jumpLinks = [{ id: 'featured', title: 'Featured' }, ...sections];

---

<BaseLayout title="Projects">
  <div class="divide-y divide-gray-200 dark:divide-gray-700">
    <div class="space-y-2 pb-8 pt-6 md:space-y-5">
      <h1 class="text-3xl font-extrabold leading-9 tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14">
        Projects
      </h1>
      <p class="text-lg leading-7 text-gray-500 dark:text-gray-400">
        A collection of projects I've worked on
      </p>
      <nav aria-label="Project sections" class="flex flex-wrap gap-x-4 gap-y-1 pt-2 text-sm font-medium">
        {jumpLinks.map(({ id, title }) => (
          <a href={`#${id}`} class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400">
            {title}
          </a>
        ))}
      </nav>
    </div>

    <section class="py-12">
      <h2 id="featured" class="mb-2 scroll-mt-24 text-2xl font-bold leading-8 tracking-tight text-gray-900 dark:text-gray-100">
        <a href="#featured" class="no-underline hover:underline">Featured</a>
      </h2>
      <p class="mb-8 text-gray-500 dark:text-gray-400">The projects I'm most excited about right now.</p>
      <div class="grid gap-8 md:grid-cols-2">
        {featured.map((project) => <Card project={project} />)}
      </div>
    </section>

    {sections.map((section) => (
      <section class="py-12">
        <h2 id={section.id} class="mb-2 scroll-mt-24 text-2xl font-bold leading-8 tracking-tight text-gray-900 dark:text-gray-100">
          <a href={`#${section.id}`} class="no-underline hover:underline">{section.title}</a>
        </h2>
        <p class="mb-8 text-gray-500 dark:text-gray-400">{section.description}</p>
        {section.large.length > 0 && (
          <div class="grid gap-8 md:grid-cols-2">
            {section.large.map((project) => <Card project={project} />)}
          </div>
        )}
        {section.compact.length > 0 && (
          <div class:list={['grid gap-4 sm:grid-cols-2 lg:grid-cols-3', section.large.length > 0 && 'mt-8']}>
            {section.compact.map((project) => <CompactCard project={project} />)}
          </div>
        )}
      </section>
    ))}
  </div>
</BaseLayout>
